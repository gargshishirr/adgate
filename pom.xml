<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.gargshishirr</groupId>
    <artifactId>adgate-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AdGate</name>
    <description>Low-latency ad eligibility, real-time budget pacing and fail-closed serving decisions</description>

    <modules>
        <module>adgate-common</module>
        <module>spend-aggregator</module>
        <module>eligibility-service</module>
        <module>traffic-sim</module>
        <module>local-infra</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <jedis-mock.version>1.1.21</jedis-mock.version>

        <!--
          Security patches on top of Spring Boot 3.5.16, the last 3.5 release. Each override fixes published
          advisories that the CI dependency scan (OSV) reports for the version Spring Boot manages. Remove an
          override once Spring Boot manages that version or newer.
        -->
        <tomcat.version>10.1.62</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <netty.version>4.1.141.Final</netty.version>
        <log4j2.version>2.25.5</log4j2.version>
        <lz4-java.version>1.11.4</lz4-java.version>
        <snappy-java.version>1.1.10.12</snappy-java.version>
        <org-json.version>20260814</org-json.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.gargshishirr</groupId>
                <artifactId>adgate-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.fppt</groupId>
                <artifactId>jedis-mock</artifactId>
                <version>${jedis-mock.version}</version>
            </dependency>

            <!-- Transitive dependencies with security fixes: compression codecs of kafka-clients, org.json of jedis. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${org-json.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

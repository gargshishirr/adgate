# AdGate Docker settings. Copy this file to deploy/.env and fill in every empty value.
# deploy/.env holds secrets: never commit it (it is in .gitignore).
# Make each secret with: openssl rand -hex 32

# API keys (32+ characters). Admin and client keys must differ.
# To rotate, list the old and new key separated by a comma, move callers to the new key, then drop the old one.
ADGATE_ADMIN_KEY=
ADGATE_CLIENT_KEY=

# Redis password. Redis requires it, and the services use it.
REDIS_PASSWORD=

# Grafana login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host ports. Everything is published on 127.0.0.1 only. Change one if it is already in use.
ELIGIBILITY_PORT=8081
ELIGIBILITY_MANAGEMENT_PORT=8181
AGGREGATOR_PORT=8082
KAFKA_PORT=9092
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
